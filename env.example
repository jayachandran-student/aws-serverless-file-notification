# AWS Configuration
AWS_REGION=ap-south-1

# SNS Topic ARN (replace with your actual ARN after deployment)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:file-upload-notifications

# S3 Bucket Name
BUCKET_NAME=serverless-file-notification-bucket

# Notification Email
NOTIFICATION_EMAIL=your-email@gmail.com
